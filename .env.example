# Supabase Configuration
# Get these from https://supabase.com > Your Project > Settings > API

# Public keys — safe to expose in the browser bundle
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server/seed scripts ONLY. NEVER prefix with VITE_.
# Used by: scripts/seed.ts (npm run seed)
# Never commit this value. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
